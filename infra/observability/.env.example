# Must be an RFC 1918, Tailscale, private IPv6, or loopback address assigned to
# the management host. Wildcard and public addresses are rejected by bootstrap.
MANAGEMENT_BIND_ADDRESS=10.20.0.10

OTLP_HOSTNAME=otel.lab.example
OTLP_USERNAME=lucia
OTLP_PASSWORD='replace-with-a-long-random-password'
OTLP_PASSWORD_HASH='$2a$14$replace_with_caddy_hash_password_output'

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD='replace-with-a-different-long-random-password'

# Prometheus enforces both this size and the 30-day retention period.
PROMETHEUS_RETENTION_SIZE=40GB
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8098;https://0.0.0.0:8099
Appliance__Mode=Installed
ConnectionStrings__redis=127.0.0.1:6379
DataProvider__Cache=Redis
DataProvider__SqlitePath=/var/lib/lucia/db/lucia.db
DataProvider__Store=SQLite
Deployment__Mode=standalone
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
LD_LIBRARY_PATH=/opt/lucia/current/app/runtimes/linux-arm64/native:/usr/local/cuda/lib64:/usr/lib/aarch64-linux-gnu
Kestrel__Certificates__Default__KeyPath=/var/lib/lucia/config/tls/agenthost.key
Kestrel__Certificates__Default__Path=/var/lib/lucia/config/tls/agenthost.crt
Observability__Mode=Off
ORT_THREADPOOL_SPIN_CONTROL=0
PluginDirectory=/var/lib/lucia/plugins
Wyoming__Diarization__ModelBasePath=/var/lib/lucia/models/speaker-embedding
Wyoming__Models__SpeechEnhancement__ModelBasePath=/var/lib/lucia/models/speech-enhancement
Wyoming__Models__Stt__ModelBasePath=/var/lib/lucia/models/stt
Wyoming__Models__Vad__ModelBasePath=/var/lib/lucia/models/vad
Wyoming__Models__WakeWord__ModelBasePath=/var/lib/lucia/models/kws

#!/usr/bin/env bash
# OS update readiness. Lucia selects the APP/APP_b OS slot with GRUB (lucia-boot-slot), so
# NVIDIA's firmware RootFS A/B setting is not required. Prints the running slot (0=APP, 1=APP_b).
set -euo pipefail

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}
efivars="${LUCIA_EFIVARS_PATH:-/sys/firmware/efi/efivars}"
mode_file="$efivars/L4TDefaultBootMode-781e084c-a330-417c-b678-38e696380cb9"
[[ -r "$mode_file" ]] \
    || fail "OS boot mode cannot be verified. Keep the appliance running and inspect UEFI configuration."
mode="$(od -An -j4 -N4 -tu4 "$mode_file" | tr -d '[:space:]')"
# 0 is GRUB (Lucia slot selection), 1 is extlinux (factory default before the first OS update).
[[ "$mode" == 0 || "$mode" == 1 ]] \
    || fail "OS updates require NVIDIA's GRUB or extlinux boot mode. Do not change firmware without a recovery plan."
slot=0
if [[ "${1:-}" == "--layout" ]]; then
    partitions="${LUCIA_PARTLABEL_DIR:-/dev/disk/by-partlabel}"
    root_mount="${LUCIA_ROOTFS_MOUNT:-/}"
    esp="${LUCIA_ESP_MOUNT:-/boot/efi}"
    grub_image="${LUCIA_GRUB_IMAGE_PATH:-/usr/share/lucia/boot/grubaa64.efi}"
    editenv="${LUCIA_GRUB_EDITENV_PATH:-/usr/bin/grub-editenv}"
    source="$(findmnt -n -o SOURCE --target "$root_mount")"
    same_device() {
        [[ -b "$1" && -b "$2" && "$(stat -Lc '%t:%T' "$1")" == "$(stat -Lc '%t:%T' "$2")" ]]
    }
    if same_device "$source" "$partitions/APP"; then
        slot=0
    elif same_device "$source" "$partitions/APP_b"; then
        slot=1
    else
        fail "The running root filesystem is not an APP or APP_b OS slot."
    fi
    disk="$(lsblk -dn -o PKNAME "$source")"
    [[ -n "$disk" ]] || fail "The root filesystem's disk could not be identified."
    for label in APP APP_b; do
        [[ -b "$partitions/$label" && "$(lsblk -dn -o PKNAME "$partitions/$label")" == "$disk" ]] \
            || fail "OS slot partitions are missing or belong to different disks. Repair the partition layout before retrying."
    done
    esp_source="$(findmnt -n -o SOURCE --mountpoint "$esp" || true)"
    [[ -n "$esp_source" && "$(lsblk -dn -o PKNAME "$esp_source")" == "$disk" ]] \
        || fail "The EFI system partition must be mounted at $esp on the OS disk."
    [[ -s "$grub_image" && -x "$editenv" ]] \
        || fail "This OS image predates GRUB slot selection. Install a newer OS image before OS updates."
    if ! uuid="$(blkid -s PARTUUID -o value "$source")" \
        || [[ ! "$uuid" =~ ^[0-9a-fA-F-]{36}$ ]]; then
        fail "The running OS partition has no valid PARTUUID."
    fi
    root_argument=""
    read -r -a arguments < "${LUCIA_CMDLINE_PATH:-/proc/cmdline}"
    for argument in "${arguments[@]}"; do
        [[ "$argument" != root=* ]] || root_argument="${argument#root=}"
    done
    [[ "${root_argument,,}" == "partuuid=${uuid,,}" ]] \
        || fail "The running kernel's root PARTUUID does not match its mounted root filesystem."
elif [[ $# -ne 0 ]]; then
    fail "Usage: lucia-rootfs-ab-check [--layout]"
fi
printf '%s\n' "$slot"

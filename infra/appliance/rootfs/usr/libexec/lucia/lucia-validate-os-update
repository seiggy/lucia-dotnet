#!/usr/bin/env bash
set -euo pipefail
umask 0077

update_root="${LUCIA_UPDATE_ROOT:-/var/lib/lucia/updates}"
state="$update_root/state/os.env"
nvbootctrl_path="${LUCIA_NVBOOTCTRL_PATH:-/usr/sbin/nvbootctrl}"
systemctl_path="${LUCIA_SYSTEMCTL_PATH:-/usr/bin/systemctl}"
curl_path="${LUCIA_CURL_PATH:-/usr/bin/curl}"
nm_online_path="${LUCIA_NM_ONLINE_PATH:-/usr/bin/nm-online}"
health_attempts="${LUCIA_UPDATE_HEALTH_ATTEMPTS:-15}"
health_delay="${LUCIA_UPDATE_HEALTH_DELAY_SECONDS:-2}"
validation_credential_path="${LUCIA_VALIDATION_CREDENTIAL_PATH:-$update_root/state/validation.key}"

[[ "$health_attempts" =~ ^[1-9][0-9]{0,2}$ \
    && "$health_delay" =~ ^(0|[1-9][0-9]{0,2})$ ]] \
    || exit 1
retry_budget_seconds="$((10#$health_attempts * (60 + 10#$health_delay)))"
((retry_budget_seconds <= 1000)) || exit 1

write_operation() {
    local action="$1"
    local operation_status="$2"
    local message="$3"
    local tag
    local operation_id
    tag="$(sed -n 's/^tag=//p' "$state")"
    operation_id="$(sed -n 's/^operation_id=//p' "$state")"
    [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || tag=""
    printf '{"Action":"%s","Channel":"os","Status":"%s","Tag":%s,"Message":"%s","LuciaRollbackAvailable":false,"OsRollbackAvailable":false,"OperationId":%s}\n' \
        "$action" \
        "$operation_status" \
        "$([[ -n "$tag" ]] && printf '"%s"' "$tag" || printf 'null')" \
        "$message" \
        "$([[ "$operation_id" =~ ^[0-9a-fA-F-]{36}$ ]] && printf '"%s"' "$operation_id" || printf 'null')" \
        > "$update_root/state/operation.json.tmp"
    sync -f "$update_root/state/operation.json.tmp"
    mv -f "$update_root/state/operation.json.tmp" \
        "$update_root/state/operation.json"
    sync -f "$update_root/state"
}

set_status() {
    local next_status="$1"
    sed -E "s/^status=.*/status=$next_status/" "$state" > "${state}.tmp"
    sync -f "${state}.tmp"
    mv -f "${state}.tmp" "$state"
    sync -f "$(dirname "$state")"
}

[[ -f "$state" ]] || exit 0
status="$(sed -n 's/^status=//p' "$state")"
if [[ "$status" != "pending" \
    && "$status" != "rollback-pending" \
    && "$status" != "rollback-recovery-pending" ]]; then
    rm -f "$validation_credential_path"
    exit 0
fi
previous_slot="$(sed -n 's/^previous_slot=//p' "$state")"
target_slot="$(sed -n 's/^target_slot=//p' "$state")"
validation_token="$(sed -n 's/^validation_token=//p' "$state")"
rollback_reason="$(sed -n 's/^rollback_reason=//p' "$state")"
[[ "$previous_slot" == "0" || "$previous_slot" == "1" ]] || exit 1
[[ "$target_slot" == "0" || "$target_slot" == "1" ]] || exit 1
[[ "$previous_slot" != "$target_slot" ]] || exit 1
current_slot="$("$nvbootctrl_path" -t rootfs get-current-slot)"

if [[ "$current_slot" != "$previous_slot" \
    && "$current_slot" != "$target_slot" ]]; then
    exit 1
fi
if [[ "$current_slot" == "$target_slot" \
    && "$status" == "rollback-pending" ]]; then
    "$nvbootctrl_path" -t rootfs set-active-boot-slot "$previous_slot"
    write_operation rollback running \
        "OS rollback is retrying the previous slot."
    "$systemctl_path" --no-block reboot
    exit 0
fi
if [[ "$current_slot" == "$previous_slot" \
    && "$status" == "rollback-recovery-pending" ]]; then
    "$nvbootctrl_path" -t rootfs set-active-boot-slot "$target_slot"
    write_operation rollback running \
        "OS rollback recovery is retrying the current slot."
    "$systemctl_path" --no-block reboot
    exit 0
fi
validation_credential=""
if [[ -r "$validation_credential_path" ]]; then
    validation_credential="$(cat "$validation_credential_path")"
fi

healthy=false
if [[ "$validation_token" =~ ^[0-9a-fA-F-]{36}$ \
    && "$validation_credential" =~ ^[0-9a-fA-F-]{36}$ ]]; then
    for ((attempt = 0; attempt < health_attempts; attempt++)); do
        if "$systemctl_path" is-active --quiet \
                lucia-redis.service lucia-agenthost.service \
            && "$nm_online_path" --quiet --timeout=30 \
            && "$curl_path" --fail --silent --show-error \
                --max-time 30 \
                --header "X-Lucia-Update-Credential: $validation_credential" \
                "http://127.0.0.1:8098/internal/appliance/update-validation/$validation_token?consume=false" \
                >/dev/null; then
            healthy=true
            break
        fi
        sleep "$health_delay"
    done
fi
if [[ "$healthy" == true ]]; then
    "$nvbootctrl_path" -t rootfs mark-boot-successful
    if [[ "$current_slot" == "$previous_slot" ]]; then
        if [[ "$rollback_reason" == "apply-failure" ]]; then
            write_operation apply failed \
                "OS update failed boot validation; the previous slot was restored successfully."
        else
            write_operation rollback succeeded \
                "OS rollback completed and passed boot validation."
        fi
        set_status rolled-back
    elif [[ "$status" == "rollback-recovery-pending" ]]; then
        if [[ "$rollback_reason" == "apply-failure" ]]; then
            write_operation apply failed \
                "OS update and fallback validation failed; the current slot was restored."
        else
            write_operation rollback failed \
                "OS rollback failed validation; the current slot was restored."
        fi
        set_status validated
    else
        write_operation apply succeeded "OS update passed boot validation."
        set_status validated
    fi
    "$curl_path" --fail --silent \
        --max-time 30 \
        --header "X-Lucia-Update-Credential: $validation_credential" \
        "http://127.0.0.1:8098/internal/appliance/update-validation/$validation_token?consume=true" \
        >/dev/null || true
    rm -f "$validation_credential_path"
    exit 0
fi

if [[ "$current_slot" == "$target_slot" && "$status" == "pending" ]]; then
    "$nvbootctrl_path" -t rootfs set-active-boot-slot "$previous_slot"
    sed -E \
        -e 's/^status=.*/status=rollback-pending/' \
        -e '/^rollback_reason=/d' \
        "$state" > "${state}.tmp"
    printf 'rollback_reason=apply-failure\n' >> "${state}.tmp"
    sync -f "${state}.tmp"
    mv -f "${state}.tmp" "$state"
    sync -f "$(dirname "$state")"
    write_operation apply running \
        "OS update failed boot validation; rollback is scheduled."
elif [[ "$current_slot" == "$previous_slot" ]]; then
    "$nvbootctrl_path" -t rootfs set-active-boot-slot "$target_slot"
    set_status rollback-recovery-pending
    write_operation rollback running \
        "OS rollback failed boot validation; the current slot is being restored."
else
    set_status failed
    if [[ "$rollback_reason" == "apply-failure" ]]; then
        write_operation apply failed \
            "OS update and fallback slot both failed boot validation."
    else
        write_operation rollback failed \
            "OS rollback and recovery slot both failed boot validation."
    fi
    rm -f "$validation_credential_path"
    exit 0
fi
"$systemctl_path" --no-block reboot
exit 0

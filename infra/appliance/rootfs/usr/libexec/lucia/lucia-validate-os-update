#!/usr/bin/env bash
# Runs after boot while an OS update or rollback is waiting. GRUB booted the trial slot at most
# once (lucia-boot-slot), so a failed trial needs only a reboot to return to the committed slot.
set -euo pipefail
umask 0077

update_root="${LUCIA_UPDATE_ROOT:-/var/lib/lucia/updates}"
state="$update_root/state/os.env"
systemctl_path="${LUCIA_SYSTEMCTL_PATH:-/usr/bin/systemctl}"
curl_path="${LUCIA_CURL_PATH:-/usr/bin/curl}"
nm_online_path="${LUCIA_NM_ONLINE_PATH:-/usr/bin/nm-online}"
health_attempts="${LUCIA_UPDATE_HEALTH_ATTEMPTS:-15}"
health_delay="${LUCIA_UPDATE_HEALTH_DELAY_SECONDS:-2}"
validation_credential_path="${LUCIA_VALIDATION_CREDENTIAL_PATH:-$update_root/state/validation.key}"
helpers="$(dirname "${BASH_SOURCE[0]}")"

[[ "$health_attempts" =~ ^[1-9][0-9]{0,2}$ \
    && "$health_delay" =~ ^(0|[1-9][0-9]{0,2})$ ]] \
    || exit 1
retry_budget_seconds="$((10#$health_attempts * (60 + 10#$health_delay)))"
((retry_budget_seconds <= 1000)) || exit 1

write_operation() {
    local action="$1"
    local operation_status="$2"
    local message="$3"
    local phase="${4:-}"
    local tag
    local operation_id
    tag="$(sed -n 's/^tag=//p' "$state")"
    operation_id="$(sed -n 's/^operation_id=//p' "$state")"
    [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || tag=""
    printf '{"Action":"%s","Channel":"os","Status":"%s","Tag":%s,"Message":"%s","LuciaRollbackAvailable":false,"OsRollbackAvailable":false,"OperationId":%s}\n' \
        "$action" \
        "$operation_status" \
        "$([[ -n "$tag" ]] && printf '"%s"' "$tag" || printf 'null')" \
        "$message" \
        "$([[ "$operation_id" =~ ^[0-9a-fA-F-]{36}$ ]] && printf '"%s"' "$operation_id" || printf 'null')" \
        > "$update_root/state/operation.json.tmp"
    python3 - "$update_root/state/operation.json" "$phase" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
temporary = path.with_suffix(".json.tmp")
status = json.loads(temporary.read_text())
previous = json.loads(path.read_text()) if path.is_file() else {}
if (
    previous.get("OperationId", previous.get("operationId")) == status["OperationId"]
    and previous.get("Channel", previous.get("channel")) == status["Channel"]
):
    for key in ("Phase", "CompletedBytes", "TotalBytes"):
        status[key] = previous.get(key, previous.get(key[0].lower() + key[1:]))
phase = sys.argv[2]
if status["Status"] == "succeeded":
    phase = "complete"
elif status["Status"] == "running" and not phase:
    phase = "restarting"
if phase:
    status.update(Phase=phase, CompletedBytes=None, TotalBytes=None)
temporary.write_text(json.dumps(status, separators=(",", ":")) + "\n")
PY
    sync -f "$update_root/state/operation.json.tmp"
    mv -f "$update_root/state/operation.json.tmp" \
        "$update_root/state/operation.json"
    sync -f "$update_root/state"
}

set_status() {
    sed -E "s/^status=.*/status=$1/" "$state" > "${state}.tmp"
    sync -f "${state}.tmp"
    mv -f "${state}.tmp" "$state"
    sync -f "$(dirname "$state")"
}

finish() {
    set_status "$1"
    write_operation "$action" "$2" "$3"
    rm -f "$validation_credential_path"
}

[[ -f "$state" ]] || exit 0
status="$(sed -n 's/^status=//p' "$state")"
previous_slot="$(sed -n 's/^previous_slot=//p' "$state")"
target_slot="$(sed -n 's/^target_slot=//p' "$state")"
validation_token="$(sed -n 's/^validation_token=//p' "$state")"
case "$status" in
    pending)
        action=apply
        trial_slot="$target_slot"
        ;;
    rollback-pending)
        action=rollback
        trial_slot="$previous_slot"
        ;;
    *)
        rm -f "$validation_credential_path"
        exit 0
        ;;
esac
[[ "$previous_slot" == "0" || "$previous_slot" == "1" ]] || exit 1
[[ "$target_slot" == "0" || "$target_slot" == "1" ]] || exit 1
[[ "$previous_slot" != "$target_slot" ]] || exit 1
if ! current_slot="$(bash "$helpers/lucia-rootfs-ab-check" --layout)"; then
    if [[ "$action" == apply ]]; then
        finish failed failed "OS slot layout is inconsistent after the update reboot. No further reboot was requested."
    else
        finish validated failed "OS slot layout is inconsistent after the rollback reboot. No further reboot was requested."
    fi
    exit 0
fi

if [[ "$current_slot" != "$trial_slot" ]]; then
    # The trial never finished starting (GRUB returned to the committed slot, or the launcher
    # fell back to extlinux). Clear any trial still on disk so a later boot cannot select it.
    bash "$helpers/lucia-boot-slot" cancel || exit 1
    if [[ "$action" == apply ]]; then
        finish rolled-back failed "The new OS did not finish starting; the previous OS is still running."
    else
        finish validated failed "The previous OS did not finish starting; the current OS is still running."
    fi
    exit 0
fi

validation_credential=""
if [[ -r "$validation_credential_path" ]]; then
    validation_credential="$(cat "$validation_credential_path")"
fi
write_operation "$action" running "OS boot health validation is running." validating

healthy=false
if [[ "$validation_token" =~ ^[0-9a-fA-F-]{36}$ \
    && "$validation_credential" =~ ^[0-9a-fA-F-]{36}$ ]]; then
    for ((attempt = 0; attempt < health_attempts; attempt++)); do
        if "$systemctl_path" is-active --quiet \
                lucia-redis.service lucia-agenthost.service \
            && "$nm_online_path" --quiet --timeout=30 \
            && "$curl_path" --fail --silent --show-error \
                --max-time 30 \
                --header "X-Lucia-Update-Credential: $validation_credential" \
                "http://127.0.0.1:8098/internal/appliance/update-validation/$validation_token?consume=false" \
                >/dev/null; then
            healthy=true
            break
        fi
        sleep "$health_delay"
    done
fi

if [[ "$healthy" == true ]]; then
    # Keep the operation pending until the commit is saved; systemd retries the validator.
    bash "$helpers/lucia-boot-slot" commit "$trial_slot" || exit 1
    "$curl_path" --fail --silent \
        --max-time 30 \
        --header "X-Lucia-Update-Credential: $validation_credential" \
        "http://127.0.0.1:8098/internal/appliance/update-validation/$validation_token?consume=true" \
        >/dev/null || true
    if [[ "$action" == apply ]]; then
        finish validated succeeded "OS update passed boot validation."
    else
        finish rolled-back succeeded "OS rollback completed and passed boot validation."
    fi
    exit 0
fi

bash "$helpers/lucia-boot-slot" cancel || exit 1
if [[ "$action" == apply ]]; then
    finish rolled-back failed "OS update failed boot validation; restarting into the previous OS."
else
    finish validated failed "OS rollback failed boot validation; restarting into the current OS."
fi
if ! "$systemctl_path" --no-block reboot; then
    # Stay non-terminal so the restarted validator requests the recovery reboot again.
    set_status "$status"
    exit 1
fi
